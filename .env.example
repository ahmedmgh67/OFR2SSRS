# Oracle2SSRS — environment configuration
# Copy this file to ".env" (which is gitignored) and fill in your values.
# Every setting is optional; the app runs with none of them set.

# Flask session secret (a random value is generated per run when unset).
# O2S_SECRET_KEY=

# Maximum upload size in MB (default 64).
# O2S_MAX_UPLOAD_MB=

# HTTP port and debug mode for `python backend/app.py`.
# PORT=5057
# O2S_DEBUG=0
